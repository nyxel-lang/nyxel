<Project>
  <!-- Shared settings for every C# project in the repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <Deterministic>true</Deterministic>
    <!-- Keep bin/obj out of the source tree: build/dotnet/{bin,obj,package}/<project>/<config>/. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)build/dotnet</ArtifactsPath>
  </PropertyGroup>

  <!-- Package metadata, used by the projects that are packable. -->
  <PropertyGroup>
    <Version>0.0.1</Version>
    <Authors>Nyxel contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nyxel-lang/nyxel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nyxel-lang/nyxel</RepositoryUrl>
    <PackageTags>nyxel;language;scripting;gamedev;dotnet</PackageTags>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
