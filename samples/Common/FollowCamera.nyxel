namespace Samples.Common

import System.Numerics
import Engine

/// 平滑跟随目标的相机。
public class FollowCamera : Behaviour {
    public var Target: Behaviour? = null
    public var Offset: Vector3 = new Vector3(0, 8, -6)
    public var SmoothTime: float = 0.3
    var velocity: Vector3 = Vector3.Zero

    // Behaviour.OnEnable 在引擎里是 protected virtual：重写时照写 protected
    protected override func OnEnable(self) {
        self.velocity = Vector3.Zero
    }

    public override func Update(self, dt: float) {
        let target = self.Target ?? return
        self.Position = Smooth.Damp(
            current = self.Position,
            target = target.Position + self.Offset,
            velocity = ref self.velocity,
            smoothTime = self.SmoothTime,
            dt = dt)
    }
}
