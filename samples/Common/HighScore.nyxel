namespace Samples.Common

import System.IO
import Engine

/// 把最高分存在一个文本文件里。
public class HighScore {
    let path: string

    public init(path: string) {
        self.path = path
    }

    /// 读不到或文件损坏时当作 0 分。
    public func Load(self) -> int {
        let text = try -> File.ReadAllText(self.path) catch e: FileNotFoundException -> return 0
        if not int.TryParse(text, out let score) {
            Log.Warn($"存档损坏，已忽略：{self.path}")
            return 0
        }
        return score
    }

    /// 和最高分比，给出评价。
    public func Rate(self, score: int) -> string {
        let best = self.Load()
        let rating = eval {
            if best == 0 {
                give "首次记录"
            }
            let ratio = score as float / best
            if ratio >= 1 {
                give "新纪录！"
            }
            give if ratio >= 0.8 -> "接近纪录" else -> "继续加油"
        }   // ratio 只在块里可见
        Log.Info($"{score} 分：{rating}")
        return rating
    }

    public func Save(self, score: int) {
        // FileStreamOptions 只有无参 init，靠设属性配置：创建时用 with 一起设好
        let options = new FileStreamOptions() with (Mode = FileMode.Create, Access = FileAccess.Write)
        try {
            using writer = new StreamWriter(self.path, options)
            writer.Write(score)
        } catch e: IOException {
            Log.Warn($"保存最高分失败：{e.Message}")
        }
    }
}
