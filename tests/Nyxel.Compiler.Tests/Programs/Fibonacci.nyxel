namespace Programs

import System

class Fibonacci {
    func Fib(n: int) -> int {
        if n < 2 {
            return n
        }
        return Fibonacci.Fib(n - 1) + Fibonacci.Fib(n - 2)
    }

    func Main() {
        for i in 0...10 {
            Console.WriteLine($"fib({i}) = {Fibonacci.Fib(i)}")
        }
    }
}
